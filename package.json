{
  "name": "kognai-coding-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A coding agent that turns a job spec into a patch with tests, behind an x402 endpoint, with the Kognai qualifier Q1 to Q5.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test qualifier/Q1/*.test.ts qualifier/Q4/*.test.ts qualifier/Q5/*.test.ts",
    "test:q1": "node --test qualifier/Q1/*.test.ts",
    "test:q5": "node --test qualifier/Q5/*.test.ts",
    "test:q4": "node --test qualifier/Q4/*.test.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
